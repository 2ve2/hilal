{
  "name": "react-native-hilal-example",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "~0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/HilalExample.xcworkspace -UseNewBuildSystem=YES -scheme HilalExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -DtestBuildType=debug -Dorg.gradle.jvmargs=-Xmx4g",
    "build:web": "expo export --platform web"
  },
  "private": true,
  "devDependencies": {
    "react-native-builder-bob": "^0.44.1",
    "react-native-monorepo-config": "^0.4.0"
  }
}
